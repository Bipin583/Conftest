# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
junit_results.xml
selected_tests.txt

# Databases & local runtime data
data/raw/*
!data/raw/README.md
data/interim/*
data/processed/*
data/splits/*
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.db-journal

# Model artifacts (keep directories)
models/baselines/*
models/ensembles/*
models/calibrated/*
!models/README.md

# Environment secrets
.env
!.env.example

# OS generated files
.DS_Store
Thumbs.db

# Screened subject repositories: full clones plus one virtualenv each.
# Reproducibility comes from the pinned commit SHAs in screening_report.json,
# which IS tracked -- re-run scripts/screen_repos.py to rebuild the checkouts.
data/repos/*
!data/repos/screening_report.json

# Scratch: probe output from validating the test-ID resolver, and screener logs.
.tmp_junit/
.tmp_*.log
.tmp_*.py
.tmp_*.md

# Throwaway 10-mutant smoke probe. The real harvest at data/harvest/ IS tracked:
# it is the ground truth, ~11 MB for ~2.5 h of compute, and a reviewer has to be
# able to inspect the recorded pytest outcomes behind every label.
data/harvest_smoke/

.claude/
