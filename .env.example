# ==============================================================================
# ConfTest Environment Configuration Template
# Copy this file to .env and adjust variables as required.
#
# Every key below is read by src/conftest/config.py (prefix CONFTEST_). Keys
# that no longer exist there have been removed rather than left as documentation
# of settings nothing consults: CONFTEST_MODEL_PATH, CONFTEST_ABSTENTION_THRESHOLD
# and CONFTEST_DEFAULT_RISK_TOLERANCE were all advertised here and all unread,
# and the abstention threshold contradicted the tuned policy by 7.5x
# (0.15 here vs tau_abstain=0.02 in models/policy_config.json).
# ==============================================================================

# Application Environment (development, testing, production)
CONFTEST_ENV=development
CONFTEST_DEBUG=true
CONFTEST_LOG_LEVEL=INFO
# Git commit baked into the container image by the Docker build (ARG GIT_SHA).
# Only meaningful for containerized deployments; leave empty locally and the
# /health endpoint honestly reports git_sha=unknown.
CONFTEST_GIT_SHA=

# API Server Settings
CONFTEST_API_HOST=127.0.0.1
CONFTEST_API_PORT=8000
CONFTEST_API_WORKERS=1

# Database Configuration (SQLite default with WAL mode enabled)
CONFTEST_DATABASE_URL=sqlite:///./data/conftest.db
CONFTEST_DB_ECHO=false

# Model & Policy Artifacts
# Paths to the serialized artifacts the API serves from. These replace paths
# that were hardcoded in the selection route, the webhook route and the engine.
CONFTEST_ENSEMBLE_PATH=./models/ensembles/5_seed_lgbm
CONFTEST_CALIBRATOR_PATH=./models/calibrator.joblib
# The tuned thresholds (tau_abstain, tau_conf, budget_ratio) live in this file
# and nowhere else. Written by: python scripts/tune_policy.py
CONFTEST_POLICY_CONFIG_PATH=./models/policy_config.json

# Repository analysed when a request does not name one
CONFTEST_DEFAULT_REPO_ROOT=./tests/sample_suite

# Selection Defaults
# Fallback test budget fraction when a request omits one. This is a budget, not
# a threshold -- thresholds come from CONFTEST_POLICY_CONFIG_PATH.
CONFTEST_DEFAULT_BUDGET_RATIO=0.25

# CORS
# JSON list of origins allowed to call the API with credentials. "*" is rejected
# when CONFTEST_ENV=production: the CORS spec forbids a wildcard origin together
# with credentials, and the previous configuration set both.
CONFTEST_CORS_ALLOW_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# GitHub Webhook Security
# The placeholder below is accepted in development and REFUSED when
# CONFTEST_ENV=production (config.py raises at startup rather than verifying
# HMAC signatures against a secret that is public in this file).
CONFTEST_GITHUB_WEBHOOK_SECRET=development_secret_only_change_in_ci
# Personal access token; required for PR diff fetches against private repos and
# to lift the 60 req/hr unauthenticated rate limit.
CONFTEST_GITHUB_TOKEN=

# Directory Paths
CONFTEST_DATA_DIR=./data
CONFTEST_MODELS_DIR=./models
