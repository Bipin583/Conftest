# Allowlist: the image only COPYs what is listed below, so everything else
# (notably data/ at ~1.7 GB of vendored repos) stays out of the build context
# that Docker -- and Render on every deploy -- has to upload.
*
!src
!dashboard
!scripts
!models
!reports
!tests/sample_suite
!deploy
!frontend
!pyproject.toml
!requirements.txt

# Frontend build inputs only -- node_modules and the local dist are rebuilt
# inside the image's node stage, never uploaded in the build context.
frontend/node_modules
frontend/dist

# Junk inside the included directories.
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.coverage
*.log
