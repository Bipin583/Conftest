# nginx front proxy for the single-service Render deployment.
#
# One public port (Render injects PORT, default 10000) serves the React
# dashboard SPA as static files and proxies the API routes to FastAPI on a
# loopback port. envsubst replaces the listen port in this template at container
# start (deploy/entrypoint.sh), so no port is hardcoded here.

upstream conftest_api {
    server 127.0.0.1:8000;
}

server {
    listen ${PORT};

    # GitHub webhook payloads and PR diff batches stay small, but leave headroom
    # over the FastAPI/Streamlit defaults so a legitimate payload never fails
    # at the proxy with a bare 413.
    client_max_body_size 10m;

    # --- API: exact routes FastAPI owns. The API's own "/" welcome route is
    # intentionally NOT listed: on the single public port, "/" belongs to the
    # dashboard and the API is reached under the paths below.
    location = /health {
        proxy_pass http://conftest_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://conftest_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /openapi.json {
        proxy_pass http://conftest_api;
        proxy_set_header Host $host;
    }

    location /docs {
        proxy_pass http://conftest_api;
        proxy_set_header Host $host;
    }

    location /redoc {
        proxy_pass http://conftest_api;
        proxy_set_header Host $host;
    }

    # --- Dashboard SPA: static files built from frontend/ (Vite). Any route
    # that is not a real file falls back to index.html so client-side routing
    # (React Router) handles /live, /calibration, etc. on reload.
    location / {
        root /app/frontend/dist;
        try_files $uri /index.html;
    }
}
